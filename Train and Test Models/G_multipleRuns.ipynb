    "# Define a function to format mean ± std\n",
    "def format_mean_std(mean, std):\n",
    "    return f\"{mean:.2f} ± {std:.2f}\"\n",
    "\n",
    "# Initialize the final results list\n",
    "formatted_results = []\n",
    "\n",
    "# Process the results for saving\n",
    "for data_type in avg_accuracies:\n",
